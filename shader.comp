#version 450 core

vec2 curlNoise(vec2 p) {
    float eps = 0.01;
    float n1 = noise(p + vec2(0, eps));
    float n2 = noise(p - vec2(0, eps));
    float n3 = noise(p + vec2(eps, 0));
    float n4 = noise(p - vec2(eps, 0));
    float dx = (n1 - n2) / (2.0 * eps);
    float dy = (n3 - n4) / (2.0 * eps);
    return vec2(dy, -dx); // rotate gradient 90° = divergence-free
}
struct Particle{
  vec3 pos;
  vec3 vel;
  float angle;
  float life;
};
layout(local_size_x=1,local_size_y=1) in;
layout(std430, binding = 0) buffer ParticleBuffer{
  Particle particles[];
};
uniform float time;
uniform float dt = 0.01;

vec2 CurlNoise(vec3 p, float t);

void main(){
  uint id = gl_GlobalInvocationID.x;
  Particle p = particles[id];

  vec2 field = curlNoise(p.pos * 0.01, time);
  p.vel = mix(p.vel, field, 0.1); // damped response to field
  p.pos += p.vel * dt;
  p.angle = atan(p.vel.y, p.vel.x); // orient sprite along velocity

  particles[id] = p; 
}
